close all;
clear all;
clc
pkg load symbolic;
%Variables simbolics
syms s I V1 V2 V3 K1 K2 R theta real

%equaciones

eq1 = s^3*theta + 5*s^2*theta+4*s*theta == 2*I
eq2 = s*I + I == s*V3
eq3 = V3 == R - V1 - V2
eq4 = V1 == K1*theta
eq5 = V2 == K2*s*theta

eq = [eq1,eq2,eq3,eq4,eq5]

W = solve(eq,[I,V1,V2,V3,theta])

Out = W.theta

In = R

G= Out/In		

A = (2*s)/((s+1)*(s^3+5*s^2+4*s))

B = simplify(A/(1+K2*s*A))

C = simplify(B/(1+K1*B))

G

C = expand(C)
